<?xml version="1.0"?>
<package format="3">
  <name>rtab_etc_bringup</name>
  <version>0.1.0</version>
  <description>Offline SLAM / localization bringup for the quadruped inspection bag (RTAB-Map + FAST-LIO / ICP odometry)</description>
  <maintainer email="team@example.com">razgrom team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_util</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <!-- fast_lio собирается отдельно из исходников, поэтому не указан как зависимость -->
  <export><build_type>ament_cmake</build_type></export>
</package>
